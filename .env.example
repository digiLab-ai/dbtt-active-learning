# Uncertainty Engine credentials.
#
# Copy to `.env` and fill in. `.env` is gitignored -- never commit real
# credentials. On Google Colab, put the same keys in the Secrets panel (the key
# icon in the left sidebar) instead of using a file; `load_credentials()` reads
# Colab secrets first and falls back to this file.

UE_PROJECT_NAME=
UE_USERNAME=
UE_PASSWORD=

# Optional: only needed for a non-standard deployment. Leave unset to use the
# default environment.
# COGNITO_USER_POOL_CLIENT_ID=
# CORE_API=
